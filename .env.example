# Where the date generator sends its answers.
#
# 1. Make a free form at https://formspree.io (it will ask for the email
#    address that should receive the messages).
# 2. Formspree gives you an endpoint that looks like the line below.
# 3. Copy this file to a new file named  .env.local  and paste yours in.
# 4. Put the same value into Vercel: Project -> Settings -> Environment
#    Variables, then redeploy.
#
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx
